# gdb settings for debugging hello.app on the reader, used by `make gdb`.
# Paths refer to the pb-go-sdk Docker image.

# Read the reader's shared libraries from the SDK sysroot instead of pulling
# them over Wi-Fi. libinkview lives in usr/local/lib in the SDK but in usr/lib
# on the reader, hence the search path. If library symbols look wrong because
# the firmware ships different builds, use `set sysroot target:` instead.
set sysroot /opt/pbsdk/SDK-B288/usr/arm-obreey-linux-gnueabi/sysroot
set solib-search-path /opt/pbsdk/SDK-B288/usr/arm-obreey-linux-gnueabi/sysroot/usr/local/lib:/opt/pbsdk/SDK-B288/usr/arm-obreey-linux-gnueabi/sysroot/usr/lib

# The Go runtime uses SIGURG to preempt goroutines, and sockets can raise
# SIGPIPE; neither should stop the debugger.
handle SIGURG nostop noprint pass
handle SIGPIPE nostop noprint pass

# Go's pretty printers and `info goroutines`.
add-auto-load-safe-path /usr/local/go/src/runtime/runtime-gdb.py

set pagination off
set confirm off
